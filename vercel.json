{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/weekly?slot=summer",
      "schedule": "30 15 * * 1"
    },
    {
      "path": "/api/cron/weekly?slot=winter",
      "schedule": "30 16 * * 1"
    }
  ]
}
